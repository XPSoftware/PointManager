<UserControl x:Class="PointManager.Views.Controls.AvatarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:PointManager.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:AvatarPathToImageConverter x:Key="PathToImage" />
        <conv:AvatarFontSizeConverter x:Key="FontSize" />
    </UserControl.Resources>

    <Grid Width="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Visibility="{Binding Student.IsArchived, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}, FallbackValue=Visible}">
            <Ellipse Fill="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="{Binding Student.AvatarInitial, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                       FontSize="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource FontSize}}"
                       FontWeight="Medium"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Student.HasCustomAvatar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}" />
            <Ellipse Visibility="{Binding Student.HasCustomAvatar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Ellipse.Fill>
                    <ImageBrush Stretch="UniformToFill"
                                ImageSource="{Binding Student.AvatarPath, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PathToImage}}" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Inverted banner pairing: brown circle, cream glyph, fixed in both themes. -->
        <Grid Visibility="{Binding Student.IsArchived, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Ellipse Fill="#6D4C00" />
            <materialDesign:PackIcon Kind="ArchiveOutline"
                                     Width="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource FontSize}, ConverterParameter=0.55}"
                                     Height="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource FontSize}, ConverterParameter=0.55}"
                                     Foreground="#FFF8E1"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>