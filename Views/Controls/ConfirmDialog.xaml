<Window x:Class="PointManager.Views.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        TextElement.FontSize="14">

    <materialDesign:Card Width="380" Margin="24" Padding="24" UniformCornerRadius="8"
                         materialDesign:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="TitleIcon" Kind="HelpCircleOutline"
                                         Width="28" Height="28" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="确认" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="确定要执行此操作吗？" />

            <!-- Optional row naming the object the action applies to, right above the buttons. -->
            <Border x:Name="TargetRow" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed"
                    Background="{DynamicResource MaterialDesignChipBackground}"
                    CornerRadius="6" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="TargetIcon" Kind="FileDocumentOutline"
                                             Width="18" Height="18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock x:Name="TargetText" Margin="8,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="确定" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
