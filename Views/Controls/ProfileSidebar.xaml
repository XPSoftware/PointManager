<UserControl x:Class="PointManager.Views.Controls.ProfileSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.Resources>
        <!-- Text-with-icon link, like the action row of the reference design. -->
        <Style x:Key="ActionLink" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="ProfileRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="管理档案" Margin="16,16,16,6"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" />

            <TextBlock Grid.Row="1" Margin="16,0,16,4" TextWrapping="Wrap" Opacity="0.75"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Text="管理与切换保存的档案。切换后立即生效。" />

            <WrapPanel Grid.Row="2" Margin="12,4,12,8">
                <Button Style="{StaticResource ActionLink}" Click="CreateProfile_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentPlusOutline" VerticalAlignment="Center" />
                        <TextBlock Text="新建档案" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionLink}" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" />
                        <TextBlock Text="打开文件夹" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionLink}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RefreshCircle" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <ListView Grid.Row="3" x:Name="ProfileList" Margin="8,0"
                      ItemContainerStyle="{StaticResource ProfileRow}"
                      SelectionChanged="ProfileList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制" Click="DuplicateProfile_Click">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="ContentCopy" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="重命名" Click="RenameProfile_Click">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="RenameOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="删除" Click="DeleteProfile_Click" Foreground="#E53935">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#E53935" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <StackPanel Orientation="Horizontal">
                                <!-- Visual only: the ListView selection performs the switch. -->
                                <RadioButton IsHitTestVisible="False" GroupName="ProfileSidebar"
                                             IsChecked="{Binding IsActive, Mode=OneWay}"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FileName}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MaterialDesignBody1TextBlock}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <materialDesign:Snackbar Grid.Row="4" x:Name="SidebarSnackbar" Margin="6,0,6,6" />
        </Grid>
    </Border>
</UserControl>
