<views:TrayWindow x:Class="PointManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:PointManager.Views"
        xmlns:controls="clr-namespace:PointManager.Views.Controls"
        xmlns:local="clr-namespace:PointManager"
        Title="设置" Height="560" Width="780"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PointManagerWindow}"
        TextElement.FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Image-2 style: color chip + hex readout inside a highlighted border -->
        <Style x:Key="ColorHexButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" CornerRadius="4"
                                BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Image-1 style: expand chevron that rotates while the card is open -->
        <Style x:Key="ExpandChevronButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <materialDesign:PackIcon x:Name="Chevron" Kind="ChevronDown"
                                                     Width="20" Height="20" VerticalAlignment="Center"
                                                     RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </materialDesign:PackIcon.RenderTransform>
                            </materialDesign:PackIcon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical tab: a primary-colored bar marks the selected item's left edge -->
        <Style x:Key="SideTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="SettingsTab" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Indicator" Grid.Column="0"
                                       Fill="{DynamicResource PrimaryHueMidBrush}" Opacity="0" />
                            <materialDesign:Ripple Grid.Column="1"
                                                   HorizontalContentAlignment="Stretch"
                                                   VerticalContentAlignment="Stretch"
                                                   Feedback="{DynamicResource MaterialDesignBody}">
                                <ContentPresenter Margin="18,13" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  TextElement.FontSize="14"
                                                  TextElement.FontWeight="Medium" />
                            </materialDesign:Ripple>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- About page: full-width flat link rows, ClassIsland-style -->
        <Style x:Key="AboutLinkButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="TextElement.FontSize" Value="14" />
        </Style>
        <Style x:Key="AboutLinkGroup" TargetType="StackPanel">
            <Style.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource AboutLinkButton}" />
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CogOutline" Width="26" Height="26" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
            </StackPanel>
        </Border>

        <!-- Body: vertical tabs + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical tab strip -->
            <Border Grid.Column="0" MinWidth="150" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <StackPanel Margin="0,8">
                    <RadioButton x:Name="TabAppearance" Style="{StaticResource SideTab}" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="外观" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabBehavior" Style="{StaticResource SideTab}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="行为" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabPoints" Style="{StaticResource SideTab}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusMinusVariant" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="加减分" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabStorage" Style="{StaticResource SideTab}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="存储" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSafety" Style="{StaticResource SideTab}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="安全" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabAbout" Style="{StaticResource SideTab}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="关于" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <Grid>

                    <!-- ===== 外观 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabAppearance, Converter={StaticResource BoolToVis}}">
                        <controls:SettingsCard Margin="5" IconGlyph="WeatherNight" Header="深色主题"
                                               IsOn="{Binding Settings.IsDarkTheme, Mode=TwoWay}" />

                        <controls:SettingsCard Margin="5" IconGlyph="Sync" Header="跟随系统主题色"
                                               Description="开启后，主题色跟随 Windows 系统的强调色。"
                                               IsOn="{Binding Settings.FollowSystemAccent, Mode=TwoWay}" />

                        <materialDesign:Card Margin="5" Padding="14,12,16,12" UniformCornerRadius="8"
                                             Visibility="{Binding IsCustomColorsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <controls:SettingsControl IconGlyph="Palette" Header="主题色" Description="应用的主色调。">
                                    <controls:SettingsControl.Switcher>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource ColorHexButton}"
                                                          IsChecked="{Binding IsPrimaryColorPopupOpen, Mode=TwoWay}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                                                   Fill="{Binding PrimaryColorBrush}"
                                                                   Stroke="{DynamicResource MaterialDesignDivider}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PrimaryColorHex}" Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                    <Popup Placement="Bottom"
                                                           IsOpen="{Binding IsPrimaryColorPopupOpen, Mode=TwoWay}"
                                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                        <materialDesign:Card Background="{DynamicResource MaterialDesignPaper}" Margin="12">
                                                            <materialDesign:ColorPicker Width="340" Height="280" Margin="10"
                                                                                      Color="{Binding PrimaryColorValue, Mode=TwoWay, Delay=100}" />
                                                        </materialDesign:Card>
                                                    </Popup>
                                                </Grid>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ExpandChevronButton}" Margin="6,0,0,0"
                                                          IsChecked="{Binding IsPrimaryColorPickerOpen, Mode=TwoWay}" />
                                        </StackPanel>
                                    </controls:SettingsControl.Switcher>
                                </controls:SettingsControl>
                                <controls:ColorPicker Margin="0,12,0,2"
                                                      Visibility="{Binding IsPrimaryColorPickerOpen, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding PrimarySwatches}"
                                                      RecentSource="{Binding RecentSwatches}"
                                                      SelectedValue="{Binding PrimaryColor, Mode=TwoWay}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Margin="5" Padding="14,12,16,12" UniformCornerRadius="8"
                                             Visibility="{Binding IsCustomColorsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <controls:SettingsControl IconGlyph="PaletteOutline" Header="强调色" Description="点缀用的辅助色。">
                                    <controls:SettingsControl.Switcher>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource ColorHexButton}"
                                                          IsChecked="{Binding IsSecondaryColorPopupOpen, Mode=TwoWay}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                                                   Fill="{Binding SecondaryColorBrush}"
                                                                   Stroke="{DynamicResource MaterialDesignDivider}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SecondaryColorHex}" Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                    <Popup Placement="Bottom"
                                                           IsOpen="{Binding IsSecondaryColorPopupOpen, Mode=TwoWay}"
                                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                        <materialDesign:Card Background="{DynamicResource MaterialDesignPaper}" Margin="12">
                                                            <materialDesign:ColorPicker Width="340" Height="280" Margin="10"
                                                                                      Color="{Binding SecondaryColorValue, Mode=TwoWay, Delay=100}" />
                                                        </materialDesign:Card>
                                                    </Popup>
                                                </Grid>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ExpandChevronButton}" Margin="6,0,0,0"
                                                          IsChecked="{Binding IsSecondaryColorPickerOpen, Mode=TwoWay}" />
                                        </StackPanel>
                                    </controls:SettingsControl.Switcher>
                                </controls:SettingsControl>
                                <controls:ColorPicker Margin="0,12,0,2"
                                                      Visibility="{Binding IsSecondaryColorPickerOpen, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding AccentSwatches}"
                                                      RecentSource="{Binding RecentSwatches}"
                                                      SelectedValue="{Binding SecondaryColor, Mode=TwoWay}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <controls:SettingsCard Margin="5" IconGlyph="FormatFont" Header="字体"
                                               Description="应用界面使用的字体。">
                            <controls:SettingsCard.Switcher>
                                <ComboBox Width="220" MaxDropDownHeight="360"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ItemsSource="{Binding FontOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.FontFamily, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontFamily="{Binding Preview}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ===== 行为 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabBehavior, Converter={StaticResource BoolToVis}}">
                        <controls:SettingsCard Margin="5" IconGlyph="WindowMinimize" Header="启动时最小化到托盘"
                                               IsOn="{Binding Settings.StartMinimizedToTray, Mode=TwoWay}" />

                        <controls:SettingsCard Margin="5" IconGlyph="ExitToApp" Header="退出前需要确认"
                                               Description="关闭时弹出确认对话框。"
                                               IsOn="{Binding Settings.ConfirmOnExit, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- ===== 加减分 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabPoints, Converter={StaticResource BoolToVis}}">
                        <materialDesign:Card Margin="5" Padding="14,12,16,12" UniformCornerRadius="8">
                            <StackPanel>
                                <controls:SettingsControl IconGlyph="Numeric" Header="快捷分值"
                                                          Description="这些分值会作为加减分窗口中的快捷按钮。"
                                                          HasSwitcher="False" />

                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Settings.PointPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Chip Content="{Binding}" Margin="0,0,8,8"
                                                                 IsDeletable="True"
                                                                 DeleteCommand="{Binding DataContext.RemovePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 DeleteCommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="添加" Command="{Binding AddPresetCommand}" />
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="新的分值（整数）"
                                             Text="{Binding NewPresetText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <controls:SettingsCard Margin="5" IconGlyph="CommentTextOutline" Header="默认备注"
                                               Description="加减分时预填的备注，可留空。">
                            <controls:SettingsCard.Switcher>
                                <TextBox Width="180" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="备注"
                                         Text="{Binding Settings.DefaultReason, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="5" IconGlyph="History" Header="历史记录上限"
                                               Description="最多保留的积分记录条数，设置为 0 则无上限。">
                            <controls:SettingsCard.Switcher>
                                <TextBox Width="180" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="条数"
                                         Text="{Binding Settings.MaxHistoryRecords, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ===== 存储 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabStorage, Converter={StaticResource BoolToVis}}">
                        <controls:SettingsCard Margin="5" IconGlyph="FolderMoveOutline" Header="数据存储位置"
                                               Description="更改时会把整份数据（设置、档案、记录）复制到新位置，之后在新位置读写。">
                            <controls:SettingsCard.Switcher>
                                <ComboBox Width="230" HorizontalAlignment="Right"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="存储位置"
                                          ItemsSource="{Binding StorageOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.DataLocation, Mode=OneWay}"
                                          SelectionChanged="DataLocation_Changed" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="5" IconGlyph="FolderTextOutline" Header="数据根目录"
                                               Description="{Binding DataRootPath}">
                            <controls:SettingsCard.Switcher>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" />
                                        <TextBlock Text="打开所在文件夹" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>

                        <!-- 档案的切换与管理在学生及小组编辑窗口的「管理档案」侧边栏里 -->

                        <!-- ===== 备份 ===== -->
                        <StackPanel Orientation="Horizontal" Margin="5,14,5,8">
                            <materialDesign:PackIcon Kind="SettingsBackupRestore" Width="20" Height="20"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="备份" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="15" FontWeight="Medium" />
                        </StackPanel>

                        <materialDesign:Card Margin="5" UniformCornerRadius="8">
                            <Expander Background="Transparent"
                                      IsExpanded="{Binding Settings.IsAutoBackupEnabled, Mode=OneWay}"
                                      TextElement.Foreground="{DynamicResource MaterialDesignBody}">
                                <Expander.Header>
                                    <controls:SettingsControl IconGlyph="AutoMode"
                                                              Header="启用自动备份"
                                                              Description="启用后，PointManager 将每隔一段时间自动备份设置、档案、记录与头像文件。"
                                                              IsOn="{Binding Settings.IsAutoBackupEnabled, Mode=TwoWay}"
                                                              Margin="-12,0" />
                                </Expander.Header>
                                <StackPanel Margin="36,0,48,12"
                                            IsEnabled="{Binding Settings.IsAutoBackupEnabled}">
                                    <controls:SettingsControl IconGlyph="ClockAutoOutline"
                                                              Header="自动备份间隔" IsCompact="True"
                                                              Description="自动备份时的间隔天数。"
                                                              Margin="0,0,0,6">
                                        <controls:SettingsControl.Switcher>
                                            <TextBox Width="100"
                                                     materialDesign:TextFieldAssist.SuffixText="天"
                                                     Text="{Binding Settings.AutoBackupIntervalDays}" />
                                        </controls:SettingsControl.Switcher>
                                    </controls:SettingsControl>
                                    <controls:SettingsControl IconGlyph="ArchiveArrowUpOutline"
                                                              Header="自动备份上限" IsCompact="True"
                                                              Description="最多保留的自动备份个数，达到上限时删除最旧的备份。设置为 0 则无上限。"
                                                              Margin="0,0,0,6">
                                        <controls:SettingsControl.Switcher>
                                            <TextBox Width="100"
                                                     materialDesign:TextFieldAssist.SuffixText="个"
                                                     Text="{Binding Settings.AutoBackupLimit}" />
                                        </controls:SettingsControl.Switcher>
                                    </controls:SettingsControl>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="上次成功自动备份：" />
                                        <Run Text="{Binding LastAutoBackupText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                        </materialDesign:Card>

                        <materialDesign:Card Margin="5" Padding="14,12,16,12" UniformCornerRadius="8">
                            <StackPanel>
                                <controls:SettingsControl IconGlyph="BackupRestore"
                                                          Header="手动备份"
                                                          Description="将设置、全部档案、积分记录与头像文件备份为 zip 压缩包。手动备份产生的备份文件不会被自动清除。"
                                                          HasSwitcher="False" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            IsEnabled="{Binding IsNotBackingUp}"
                                            Command="{Binding BackupNowCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BackupRestore" VerticalAlignment="Center" />
                                            <TextBlock Text="立即备份" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding OpenBackupFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" />
                                            <TextBlock Text="查看备份文件…" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center"
                                                             ToolTip="备份成功。"
                                                             Visibility="{Binding IsBackupFinished, Converter={StaticResource BoolToVis}}" />
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Width="20" Height="20" Margin="6,0,0,0"
                                                 IsIndeterminate="True" VerticalAlignment="Center"
                                                 Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- ===== 积分 ===== -->
                        <StackPanel Orientation="Horizontal" Margin="5,14,5,8">
                            <materialDesign:PackIcon Kind="PlusMinusVariant" Width="20" Height="20"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="积分" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="15" FontWeight="Medium" />
                        </StackPanel>

                        <controls:SettingsCard Margin="5" IconGlyph="History" Header="积分记录"
                                               Description="{Binding HistoryHint}" HasSwitcher="False" />

                        <controls:SettingsCard Margin="5" IconGlyph="DatabaseImportOutline" Header="迁移旧数据"
                                               Description="{Binding LegacyHint}"
                                               Visibility="{Binding IsLegacyPending, Converter={StaticResource BoolToVis}}">
                            <controls:SettingsCard.Switcher>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="迁移"
                                        Click="MigrateLegacy_Click" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="5" IconGlyph="DeleteSweep" Header="清空积分记录"
                                               Description="删除当前档案的所有加减分历史记录，不可撤销。">
                            <controls:SettingsCard.Switcher>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="清空"
                                        Click="ClearHistory_Click" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>

                        <controls:SettingsCard Margin="5" IconGlyph="RestartAlert" Header="重置所有积分"
                                               Description="将所有学生积分归零并清空记录，不可撤销。">
                            <controls:SettingsCard.Switcher>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="重置"
                                        Foreground="#E53935" BorderBrush="#E53935" Click="ResetPoints_Click" />
                            </controls:SettingsCard.Switcher>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- ===== 安全 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabSafety, Converter={StaticResource BoolToVis}}">
                        <controls:SettingsCard Margin="5" IconGlyph="ClipboardCheckOutline" Header="启动时自动校验总分"
                                               Description="启动时自动比对学生总分与历史记录合计，发现不一致时弹窗提示，可按历史记录修正。"
                                               IsOn="{Binding Settings.IsAutoVerifyEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- ===== 关于 ===== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=TabAbout, Converter={StaticResource BoolToVis}}">
                        <!-- Banner + 名称 / 版本 / 版权 -->
                        <materialDesign:Card Margin="5" ClipContent="True" UniformCornerRadius="8">
                            <StackPanel>
                                <Border Height="120" Background="{DynamicResource PrimaryHueMidBrush}">
                                    <Image x:Name="AboutIcon" Width="64" Height="64"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Margin="24,14,24,16">
                                    <TextBlock>
                                        <Run Text="PointManager" FontSize="24" FontWeight="Medium" />
                                        <Run Text=" " />
                                        <Run Text="{x:Static local:App.AppVersion}" FontSize="16" />
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Text="Copyright © 2026 XPSoftware"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <TextBlock Margin="0,8,0,0" Text="一款轻量的本地学生积分管理工具。"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 项目链接 -->
                        <materialDesign:Card Margin="5,12,5,0" ClipContent="True" UniformCornerRadius="8">
                            <StackPanel Style="{StaticResource AboutLinkGroup}">
                                <Button Tag="https://github.com/XPSoftware/PointManager" Click="AboutLink_Click">
                                    <Grid>
                                        <TextBlock Text="GitHub 仓库" VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="ExternalLink" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Separator Margin="0,-0.5" Opacity="0.5" />
                                <Button Tag="https://github.com/XPSoftware/PointManager/issues" Click="AboutLink_Click">
                                    <Grid>
                                        <TextBlock Text="问题反馈 / 功能建议" VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="ExternalLink" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 诊断 -->
                        <materialDesign:Card Margin="5,12,5,0" ClipContent="True" UniformCornerRadius="8">
                            <StackPanel Style="{StaticResource AboutLinkGroup}">
                                <Button Click="AboutDiagnostics_Click">
                                    <Grid>
                                        <TextBlock Text="查看诊断信息" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 鸣谢 -->
                        <materialDesign:Card Margin="5,12,5,0" ClipContent="True" UniformCornerRadius="8">
                            <StackPanel Style="{StaticResource AboutLinkGroup}">
                                <TextBlock Text="鸣谢" FontWeight="Bold" Margin="24,12,24,6" />
                                <Button Click="AboutLibraries_Click">
                                    <Grid>
                                        <TextBlock Text="第三方库" VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="PackageVariant" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <TextBlock LineHeight="26" Margin="24,12,24,16" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    界面主题与部分控件使用了 MaterialDesignInXamlToolkit 框架。<LineBreak />
                                    托盘图标能力由 Hardcodet.NotifyIcon.Wpf 提供。<LineBreak />
                                    MVVM 基础设施使用了 CommunityToolkit.Mvvm。<LineBreak />
                                    <!--感谢所有使用本工具并提出建议的老师与同学。-->
                                </TextBlock>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 许可与隐私 -->
                        <materialDesign:Card Margin="5,12,5,5" ClipContent="True" UniformCornerRadius="8">
                            <StackPanel Style="{StaticResource AboutLinkGroup}">
                                <Button Click="AboutLicense_Click">
                                    <Grid>
                                        <TextBlock Text="查看开放源代码许可" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Separator Margin="0,-0.5" Opacity="0.5" />
                                <Button Click="AboutPrivacy_Click">
                                    <Grid>
                                        <TextBlock Text="隐私说明" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</views:TrayWindow>
