<views:TrayWindow x:Class="PointManager.Views.ScoreViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:PointManager.Views"
        xmlns:conv="clr-namespace:PointManager.Converters"
        Title="总分查看" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PointManagerWindow}"
        TextElement.FontSize="14">

    <Window.Resources>
        <conv:DeltaToBrushConverter x:Key="DeltaBrush" />
        <conv:SignedIntConverter x:Key="SignedInt" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FormatListNumbered" Width="26" Height="26" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                <TextBlock Text="总分查看" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
            </StackPanel>
        </Border>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="16,16,16,4">
            <materialDesign:Card Padding="16" Margin="0,0,8,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="小组数" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding GroupCount}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="学生数" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding StudentCount}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="4,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="总积分" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding TotalPoints}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Margin="8,0,0,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="记录数" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding RecordCount}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Student totals -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="8" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,8,8,8">
                        <TextBlock Text="学生总分（点击列标题排序）" VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                        <Button HorizontalAlignment="Right" Click="VerifyTotals_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                ToolTip="按历史记录重新合计每名学生的总分，与当前总分比对">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="校验总分" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Students}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="小组" Binding="{Binding GroupName}" Width="140" />
                            <DataGridTextColumn Header="积分" Binding="{Binding Points}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Right: group totals + records -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="8" Margin="0,0,0,12" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MaxHeight="180" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="小组总分" Margin="8,8,8,8"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                        <ListView Grid.Row="1" ItemsSource="{Binding GroupSummaries}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MaterialDesignBody1TextBlock}" />
                                            <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}">
                                                <Run Text="{Binding MemberCount, Mode=OneWay}" /> 人 · 平均
                                                <Run Text="{Binding AveragePoints, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"
                                                   FontSize="16" Text="{Binding TotalPoints}"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Padding="8" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="最近积分记录" Margin="8,8,8,8"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                        <ListView Grid.Row="1" ItemsSource="{Binding Records}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Width="46" FontWeight="Bold" VerticalAlignment="Center"
                                                   Text="{Binding Delta, Converter={StaticResource SignedInt}}"
                                                   Foreground="{Binding Delta, Converter={StaticResource DeltaBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                <Run Text="{Binding StudentName, Mode=OneWay}" />
                                                <Run Text="·" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <Run Text="{Binding GroupName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}">
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=MM-dd HH:mm}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <materialDesign:Snackbar Grid.Row="2" x:Name="Snackbar" />
    </Grid>
</views:TrayWindow>
