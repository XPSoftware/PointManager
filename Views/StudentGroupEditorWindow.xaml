<views:TrayWindow x:Class="PointManager.Views.StudentGroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:PointManager.Views"
        xmlns:controls="clr-namespace:PointManager.Views.Controls"
        xmlns:conv="clr-namespace:PointManager.Converters"
        Title="学生及小组编辑"
        Height="620" Width="960"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PointManagerWindow}"
        TextElement.FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- Flat list row: stretch the content so badges sit at the right edge -->
        <Style x:Key="ListRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Tab button that lives inside the colored title bar -->
        <Style x:Key="HeaderTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="EditorTab" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <materialDesign:Ripple Grid.Row="0"
                                                   HorizontalContentAlignment="Stretch"
                                                   VerticalContentAlignment="Stretch"
                                                   Feedback="{DynamicResource PrimaryHueMidForegroundBrush}">
                                <ContentPresenter Margin="20,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="Medium" />
                            </materialDesign:Ripple>
                            <Rectangle x:Name="Indicator" Grid.Row="1"
                                       Fill="{DynamicResource PrimaryHueMidForegroundBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="EditorDialog">
        <!-- The 管理档案 drawer overlays the whole window, title bar included -->
        <materialDesign:DrawerHost x:Name="ProfileDrawer">
            <materialDesign:DrawerHost.RightDrawerContent>
                <controls:ProfileSidebar x:Name="ProfilePanel" Width="300" />
            </materialDesign:DrawerHost.RightDrawerContent>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar with inline tabs -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" MinHeight="54">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="26" Height="26"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                            <TextBlock Text="学生及小组编辑" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                        </StackPanel>

                        <materialDesign:Chip Grid.Column="1" x:Name="ProfileChip"
                                             Margin="20,0,0,0" VerticalAlignment="Center"
                                             Style="{StaticResource MaterialDesignOutlineChip}"
                                             Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                             Content="Default.json"
                                             ToolTip="管理与切换档案"
                                             Click="ToggleProfilePanel_Click">
                            <materialDesign:Chip.IconBackground>
                                <SolidColorBrush Color="White" Opacity="0.22" />
                            </materialDesign:Chip.IconBackground>
                            <materialDesign:Chip.Icon>
                                <materialDesign:PackIcon Kind="FileDocumentOutline" />
                            </materialDesign:Chip.Icon>
                        </materialDesign:Chip>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                                    HorizontalAlignment="Right">
                            <RadioButton x:Name="TabGroups" Style="{StaticResource HeaderTab}"
                                         Content="小组" IsChecked="True" />
                            <RadioButton x:Name="TabStudents" Style="{StaticResource HeaderTab}"
                                         Content="学生" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="12">

                    <!-- ================= 小组 ================= -->
                    <Grid Visibility="{Binding IsChecked, ElementName=TabGroups, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: toolbar + group list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Click="AddGroup_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="新建小组" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}"
                                            Command="{Binding RemoveGroupCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                            <TextBlock Text="删除" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="GroupList" Margin="0,8,8,0"
                                     ItemsSource="{Binding Groups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     ItemContainerStyle="{StaticResource ListRow}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="GoogleClassroom"
                                                    Width="22" Height="22" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                                <TextBlock Text="{Binding MemberCount, StringFormat={}{0} 名学生}"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" Background="Transparent" />

                        <!-- Right: selected group detail -->
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="请选择左侧的小组进行编辑"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Visibility="{Binding HasSelectedGroup, Converter={StaticResource InvBoolToVis}}" />

                            <Grid Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Margin="0,0,0,8"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="小组名称"
                                         Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Grid.Row="1" BorderThickness="0,0,0,1" Padding="0,0,0,6"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Click="AddStudentToGroup_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountPlus" VerticalAlignment="Center" />
                                                <TextBlock Text="添加学生" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarButton}"
                                                Command="{Binding RemoveStudentFromGroupCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountRemove" VerticalAlignment="Center" />
                                                <TextBlock Text="删除学生" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarButton}"
                                                Command="{Binding UngroupSelectedStudentCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountArrowRight" VerticalAlignment="Center" />
                                                <TextBlock Text="移出本组" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="2" Margin="0,10,0,0"
                                          ItemsSource="{Binding GroupStudentsView}"
                                          SelectedItem="{Binding SelectedStudentInGroup}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="False"
                                          Style="{StaticResource MaterialDesignDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="姓名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="当前积分" Binding="{Binding Points}" Width="120" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ================= 学生 ================= -->
                    <Grid Visibility="{Binding IsChecked, ElementName=TabStudents, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="0,0,0,6"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Click="AddStudent_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountPlus" VerticalAlignment="Center" />
                                            <TextBlock Text="新建学生" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}"
                                            Command="{Binding RemoveStudentCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountRemove" VerticalAlignment="Center" />
                                            <TextBlock Text="删除" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" x:Name="StudentList" Margin="0,8,8,0"
                                     ItemsSource="{Binding Students}"
                                     SelectedItem="{Binding SelectedStudent}"
                                     ItemContainerStyle="{StaticResource ListRow}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="AccountCircleOutline"
                                                    Width="22" Height="22" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                                <TextBlock Text="{Binding GroupName}"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10"
                                                    Padding="8,2" Background="{DynamicResource SecondaryHueMidBrush}">
                                                <TextBlock Text="{Binding Points}" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryHueMidForegroundBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" Background="Transparent" />

                        <!-- Right: student detail form -->
                        <Border Grid.Column="2" Margin="8,0,0,0">
                            <StackPanel Margin="8,4" DataContext="{Binding SelectedStudent}">
                                <TextBlock Text="学生档案" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Margin="0,0,0,16" />
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="姓名"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Margin="0,16,0,0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="所属小组"
                                          ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding DataContext.SelectedStudentGroupId, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.RemoveSelectedStudentFromGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountArrowRight" VerticalAlignment="Center" />
                                        <TextBlock Text="移出小组（设为未分组）" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <materialDesign:Card Margin="0,20,0,0" Padding="16" UniformCornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="28" Height="28"
                                                                 Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="当前积分" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding Points}" FontSize="26" FontWeight="Bold" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <materialDesign:Snackbar Grid.Row="2" x:Name="Snackbar" />
            </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</views:TrayWindow>
